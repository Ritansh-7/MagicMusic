SPOTIFY_CLIENT_ID = "your-client-id"
SPOTIFY_CLIENT_SECRET = "your-client-secret"
SPOTIFY_REDIRECT_URI = "http://127.0.0.1:8501"
# Aiven MySQL: use the exact connection string from Aiven, with URL-encoded
# password characters when needed.
DATABASE_URL = "mysql://user:password@host:3306/tunematch"
REDIS_URL = "redis://default:password@host:port/0"
COZYBEATS_SESSION_SECRET = "replace-with-a-long-random-secret"

# LLM intent classification (Groq / OpenAI / Ollama / HF Inference Endpoints /
# any OpenAI-compatible API). Uncomment and fill in your values.
# Get an HF access token from https://huggingface.co/settings/tokens
# Deploy a model via HF Inference Endpoints or use Together/Fireworks/etc.
# LLM_API_KEY = "hf_your-token-here"
# LLM_BASE_URL = "https://your-endpoint.us-east-1.aws.endpoints.huggingface.cloud/v1/chat/completions"
# LLM_MODEL = "meta-llama/Llama-3.1-8B-Instruct"
# LLM_REQUEST_TIMEOUT = 30
